}

OreMultiplier: {
	Label: Руды
	Tooltip: Умножает количество руд в мире.
}

TreeMultiplier: {
	Label: Деревья
	Tooltip: Умножает количество деревье в мире.
}

MicroMultiplier: {
	Label: Структуры
	Tooltip:
		'''
		Умножает количество структур (рельсы для вагонеток,
		святилища мечей и т.д.) в мире.
		'''
}

OceanCaves: {
	Label: Пещера в океане
	Tooltip: Гарантирует пещеру под одним из океанов в мире. («Пьяное» зерно)
}

SurfaceTemple: {
	Label: Храм на поверхности
	Tooltip: Генерирует храм джунглей на поверхности. (Зерно «Get fixed boi»)
}

EvilSurface: {
	Label: Заражённая поверхность
	Tooltip: Покрывает всю поверхность мировым злом. (Зерно «Get fixed boi»)
}

NoTraps: {
	Label: «Никаких» ловушек
	Tooltip: Значительно увеличивает количество ловушек в мире. (Зерно «Без ловушек»)
}

MushroomLayer: {
	Label: Слой грибных пещер
	Tooltip: Генерирует слой грибных пещер над преисподней. (Зерно «Get fixed boi»)
}

RainbowCabins: {
	Label: Радужные хижины
	Tooltip: Раскрашивает все подземные хижины в радугу краской или радужными блоками. (Зерно «Празднование»)
}

PaintEverything: {
	Label: Краска повсюду
	Tooltip: Раскрашивает всё. (Зернр «Празднование»)
}

MahoganyTrees: {
	Label: Красные живые деревья
	Tooltip: Красные живые деревья можно встретить на повехности. («Пьяное» зерно)
}

UndergroundDungeon: {
	Label: Подземная темница
	Tooltip:
		'''
		Генерирует вход в темницу через увядающее живое дерево
		вместо обычного входа на поверхности. («Пьяное» зерно)
		'''
}

MarbleGraniteSwapped: {
	Label: Поменять мрамор/гранит
	Tooltip: Меняет местами позиции и формы мраморных и гранитных пещер. («Пьяное» зерно)
}
